# HOOPS AI runtime settings
#
# This file lists only the variables a user or operator actually touches. The
# first group (license, SDK dir, data dir, checkpoint name) is what you decide
# when getting started; the rest, under "Optional performance tuning", is tuned
# per machine or data size. Every other internal knob is catalogued in config.py
# (the "Environment variable reference" block near the top), not here.
#
# Every value below is OPTIONAL for a redistributed package: when a value is
# unset it is derived from the package layout (see the note on each variable).
# Setting precedence is os.environ > this .env file > derived default, except
# HOOPS_AI_LICENSE which is read from this file only (never from os.environ).

# HOOPS AI license key.
# Development fallback only: a distributed package activates the license from the
# compiled shim, so this line must be ABSENT from a distributed .env. When unset
# and no compiled shim is present, license activation fails at startup.
HOOPS_AI_LICENSE=your_license_key_here

# Absolute path to a HOOPS AI SDK install directory (must contain notebooks/ and
# packages/). Optional developer convenience: it lets a machine with a full SDK
# install reuse that install's bundled checkpoints. When unset (the normal case
# for a redistributed package) checkpoints are resolved from the data root and
# app directory instead; named indexes under the data root still work.
#HOOPS_AI_SDK_DIR=C:\path\to\hoops_ai

# Data root: parent directory for uploads/ indexes/ jobs/ out/ embeddings_cache/
# and models/. When unset it defaults to <app>/data (a data/ subdirectory of the
# app), keeping the runtime data separate from the source. Set this to place the
# (potentially tens of GB of) data on another volume.
#HOOPS_AI_DATA_DIR=D:\hoops_ai_data

# Embeddings checkpoint file name. When set, this names the *.ckpt file to use;
# it is looked up in <DATA_ROOT>/models/, then <APP_ROOT>/models/, then
# <HOOPS_AI_SDK_DIR>/packages/trained_ml_models/ (first match wins). Other .ckpt
# files next to it are ignored.
# When unset, the checkpoint is resolved from <DATA_ROOT>/models/ then
# <APP_ROOT>/models/ (exactly one *.ckpt must be present).
#HOOPS_AI_EMBEDDINGS_MODEL_NAME=ts3d_2M_hoops_embeddings_SIGNAL-preview.ckpt

# --- Optional performance tuning ------------------------------------------
# All values below are optional and resolve to their defaults when unset.
# See the "Memory sizing" and "Startup warmup" sections of README.md for
# guidance. Only the few knobs an operator realistically tunes appear here; the
# full catalogue of internal settings lives in config.py (the "Environment
# variable reference" block near the top).

# Comma-separated index names to warm in the background at startup (named
# searcher, Shape Map and assembly matcher), so the first user does not pay the
# cold build cost. UNSET MEANS NO WARMUP (the default). Opt-in per deployment:
# only an administrator knows which index to warm.
#HOOPS_AI_WARMUP_INDEXES=tmcad

# Cap on how many of HOOPS_AI_WARMUP_INDEXES are actually warmed, so a
# many-index host still starts quickly (default 1).
#HOOPS_AI_WARMUP_MAX=1

# Which warmup stages to run, as a comma-separated list of assembly, map, scs
# and searcher. Unset means all of them. The assembly matcher is the slowest
# stage by far, so a deployment that does not use assembly search can leave it
# out and start that much sooner.
#HOOPS_AI_WARMUP_STAGES=map,scs,searcher

# Memory budget (MB) for the in-process named-index WRITE store (used by
# create/add/remove, not by search). Least-recently-used indexes are evicted
# above this and transparently reloaded from disk on the next write. Bounded by
# memory, not entry count, because index sizes vary widely (default 1024, about
# three tmcad-sized indexes).
#HOOPS_AI_INDEX_CACHE_MAX_MB=1024

# Memory budget (MB) for the in-process embedding cache. It is disk-backed, so
# an evicted entry is reloaded, not recomputed (default 256).
#HOOPS_AI_EMBED_CACHE_MAX_MB=256

# --- Demo features ---------------------------------------------------------

# Show the webinar-demo-only parts of the web client (the Estimate panel, which
# predicts production records from the Context Layer). Off unless set: those
# predictions only mean something once an index carries real production
# records, and the demo seeds fabricated ones. The context API itself stays
# available either way (default off).
#HOOPS_AI_DEMO=true
