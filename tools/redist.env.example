# HOOPS AI Similarity Search Server - deployment settings
#
# Every setting below is OPTIONAL: when unset it is derived from the package
# layout. You only need this file to override a default (most commonly the data
# directory). Setting precedence is os.environ > this .env file > derived default.
#
# The license key is embedded in the product (compiled license shim). Do NOT add
# a HOOPS_AI_LICENSE line here: a plaintext key must never ship with the package.

# Data root: parent directory for uploads/ indexes/ jobs/ out/ embeddings_cache/
# and models/. When unset it defaults to <app>/data (a data/ subdirectory of the
# app), keeping the runtime data separate from the source. Set this to place the
# (potentially tens of GB of) data on another volume.
#HOOPS_AI_DATA_DIR=D:\hoops_ai_data

# Log level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
#HOOPS_AI_LOG_LEVEL=INFO

