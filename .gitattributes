* text=auto

# Batch files must reach Windows with CRLF whatever platform cloned the
# repository: cmd.exe mis-parses LF-only `if ( ... )` blocks, which
# tools/scs_points/build.bat is built out of.
*.bat text eol=crlf

# Documents obtained from outside this repository. Keeping them out of the text
# machinery is an operational rule, not a legal judgement: git must never rewrite
# a byte of a file we did not author, so what ships is what we received.
third_party_notices/** -text
THIRD-PARTY-NOTICES.md -text
